# Copy this file to .env and fill in real values before running in
# anything beyond local/demo mode. Never commit the actual .env file.

# development | staging | production
ENVIRONMENT=development

# SQLite for local/demo. Use a postgresql:// URL in production.
DATABASE_URL=sqlite:///./s41_dev.db

# MUST be overridden with a long, random value in production.
# e.g. generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_this_is_a_dev_only_default_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-separated list of allowed frontend origins for CORS.
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5500,http://localhost:5500

# Optional AI keys — only ONE provider is needed. Priority: Gemini → Anthropic → Groq → OpenAI → Ollama
# If none are set, the autonomous Deep Financial Reasoner handles all queries (no API key needed).
#
# Google Gemini (free tier at https://aistudio.google.com)
GEMINI_API_KEY=
# Anthropic Claude (https://console.anthropic.com) — supports claude-sonnet-4-6, claude-3-5-haiku, etc.
ANTHROPIC_API_KEY=
# Groq Cloud — free fast inference (https://console.groq.com)
GROQ_API_KEY=
# OpenAI
OPENAI_API_KEY=
# Local Ollama (e.g. http://localhost:11434)
OLLAMA_BASE_URL=
# Generic fallback key if you use a single AI_API_KEY env var
AI_API_KEY=
# Override the model used (e.g. gemini-1.5-flash, claude-sonnet-4-6, gpt-4o-mini, llama3.2)
AI_PROVIDER_MODEL=gemini-1.5-flash
