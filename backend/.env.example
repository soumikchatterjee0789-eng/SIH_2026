# Copy this file to .env and fill in real values before running in
# anything beyond local/demo mode. Never commit the actual .env file.

# development | staging | production
ENVIRONMENT=development

# SQLite for local/demo. Use a postgresql:// URL in production.
DATABASE_URL=sqlite:///./s41_dev.db

# MUST be overridden with a long, random value in production.
# e.g. generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_this_is_a_dev_only_default_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-separated list of allowed frontend origins for CORS.
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5500,http://localhost:5500

# Optional - only used for future natural-language phrasing of already
# computed answers. Everything works correctly without it.
AI_API_KEY=
AI_PROVIDER_MODEL=claude-sonnet-4-6
