# Copy this file to .env and fill in real values before running.
# Never commit the actual .env file (it's already in .gitignore).

ENVIRONMENT=development

# PostgreSQL in production, e.g.:
# DATABASE_URL=postgresql://user:password@localhost:5432/s41_db
# SQLite is fine for local development/demo:
DATABASE_URL=sqlite:///./s41_dev.db

# Generate a strong random value for production, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_this_is_a_dev_only_default_key
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-separated list of frontend origins allowed to call this API
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional: only used for natural-language phrasing assistance.
# The credit-readiness engine and assistant work correctly without this set.
AI_API_KEY=
